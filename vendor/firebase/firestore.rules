rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null
        && (request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'password'
          || request.auth.token.get('email_verified', false) == true);
    }
    function owns(uid) {
      return authenticated() && request.auth.uid == uid;
    }
    function professionalOwner(id) {
      let profile = get(/databases/$(database)/documents/professionals/$(id)).data;
      return owns(id) && profile.ownerUid == request.auth.uid && profile.active == true;
    }
    function linkedProfessional(uid) {
      let access = get(/databases/$(database)/documents/users/$(uid)/access/main).data;
      let id = access.professionalId;
      let seatId = access.seatId;
      let seat = get(/databases/$(database)/documents/professionals/$(id)/seats/$(seatId)).data;
      let link = get(/databases/$(database)/documents/professionals/$(id)/patients/$(uid)).data;
      return request.auth != null && professionalOwner(id)
        && access.kind == 'invitation' && access.expiresAt > request.time.toMillis()
        && seat.status == 'active' && seat.expiresAt > request.time.toMillis()
        && seat.occupantUid == uid && link.patientId == uid && link.seatId == seatId;
    }
    function validGameLevel(value) {
      let level = value.level;
      let evidence = value.evidence;
      return value is map && value.keys().hasOnly(['level', 'evidence'])
        && level is int && level >= 1 && level <= 10
        && evidence is list && evidence.size() < 3
        && (evidence.size() < 1 || (evidence[0] is int && evidence[0] >= 0 && evidence[0] <= 100))
        && (evidence.size() < 2 || (evidence[1] is int && evidence[1] >= 0 && evidence[1] <= 100));
    }
    function validTrial(value) {
      return value is map && value.keys().hasOnly(['accuracy', 'questions', 'hints', 'skipped'])
        && value.accuracy is number && value.accuracy >= 0 && value.accuracy <= 100
        && value.questions is int && value.questions >= 0 && value.questions <= 1000
        && value.hints is int && value.hints >= 0 && value.hints <= 1000 && value.skipped is bool;
    }
    function validLevels(value) {
      let previous = resource == null ? {} : resource.data.data.profile.get('gameLevels', {});
      return value is map && value.keys().hasOnly(['visual-scanning', 'language-naming', 'word-completion', 'memory-path', 'memory-pairs', 'categorization', 'motor-target', 'motor-tracking'])
        && (!('visual-scanning' in value) || value['visual-scanning'] == previous.get('visual-scanning', null) || validGameLevel(value['visual-scanning']))
        && (!('language-naming' in value) || value['language-naming'] == previous.get('language-naming', null) || validGameLevel(value['language-naming']))
        && (!('word-completion' in value) || value['word-completion'] == previous.get('word-completion', null) || validGameLevel(value['word-completion']))
        && (!('memory-path' in value) || value['memory-path'] == previous.get('memory-path', null) || validGameLevel(value['memory-path']))
        && (!('memory-pairs' in value) || value['memory-pairs'] == previous.get('memory-pairs', null) || validGameLevel(value['memory-pairs']))
        && (!('categorization' in value) || value['categorization'] == previous.get('categorization', null) || validGameLevel(value['categorization']))
        && (!('motor-target' in value) || value['motor-target'] == previous.get('motor-target', null) || validGameLevel(value['motor-target']))
        && (!('motor-tracking' in value) || value['motor-tracking'] == previous.get('motor-tracking', null) || validGameLevel(value['motor-tracking']));
    }
    function validPlacement(value) {
      let previous = resource == null ? {} : resource.data.data.profile.get('placement', {}).get('trials', {});
      return value is map && value.keys().hasOnly(['version', 'completed', 'trials'])
        && value.version == 1 && value.completed is bool && value.trials is map
        && value.trials.keys().hasOnly(['visual-scanning', 'language-naming', 'word-completion', 'memory-path', 'memory-pairs', 'categorization', 'motor-target', 'motor-tracking'])
        && (!value.completed || value.trials.keys().hasAll(['visual-scanning', 'language-naming', 'word-completion', 'memory-path', 'memory-pairs', 'categorization', 'motor-target', 'motor-tracking']))
        && (!('visual-scanning' in value.trials) || value.trials['visual-scanning'] == previous.get('visual-scanning', null) || validTrial(value.trials['visual-scanning']))
        && (!('language-naming' in value.trials) || value.trials['language-naming'] == previous.get('language-naming', null) || validTrial(value.trials['language-naming']))
        && (!('word-completion' in value.trials) || value.trials['word-completion'] == previous.get('word-completion', null) || validTrial(value.trials['word-completion']))
        && (!('memory-path' in value.trials) || value.trials['memory-path'] == previous.get('memory-path', null) || validTrial(value.trials['memory-path']))
        && (!('memory-pairs' in value.trials) || value.trials['memory-pairs'] == previous.get('memory-pairs', null) || validTrial(value.trials['memory-pairs']))
        && (!('categorization' in value.trials) || value.trials['categorization'] == previous.get('categorization', null) || validTrial(value.trials['categorization']))
        && (!('motor-target' in value.trials) || value.trials['motor-target'] == previous.get('motor-target', null) || validTrial(value.trials['motor-target']))
        && (!('motor-tracking' in value.trials) || value.trials['motor-tracking'] == previous.get('motor-tracking', null) || validTrial(value.trials['motor-tracking']));
    }
    function validProgress() {
      let value = request.resource.data;
      let profile = value.data.profile;
      return value.keys().hasAll(['schemaVersion', 'data', 'updatedAt'])
        && value.keys().hasOnly(['schemaVersion', 'data', 'updatedAt'])
        && value.schemaVersion == 1
        && value.updatedAt == request.time
        && value.data.keys().hasOnly(['profile', 'history'])
        && value.data.history is list && value.data.history.size() <= 60
        && profile.keys().hasOnly(['name', 'streakDays', 'lastActiveDate', 'totalMinutes',
          'totalSessions', 'totalScore', 'domainProgress', 'dailyPlanCompletedToday',
          'settings', 'therapistNotes', 'prescribedDomains', 'therapistGuidanceNote', 'placement', 'gameLevels'])
        && (!('placement' in profile) || (resource != null && profile.placement == resource.data.data.profile.get('placement', null)) || validPlacement(profile.placement))
        && (!('gameLevels' in profile) || (resource != null && profile.gameLevels == resource.data.data.profile.get('gameLevels', null)) || validLevels(profile.gameLevels))
        && (!('placement' in profile) || !profile.placement.completed || ('gameLevels' in profile && profile.gameLevels.keys().hasAll(['visual-scanning', 'language-naming', 'word-completion', 'memory-path', 'memory-pairs', 'categorization', 'motor-target', 'motor-tracking'])))
        && profile.name is string && profile.name.size() <= 200
        && profile.totalSessions is int && profile.totalSessions >= 0
        && profile.totalMinutes is int && profile.totalMinutes >= 0
        && profile.totalScore is number && profile.totalScore >= 0
        && profile.streakDays is int && profile.streakDays >= 0
        && profile.lastActiveDate is string
        && profile.dailyPlanCompletedToday is bool
        && profile.domainProgress is map && profile.settings is map
        // This patient-only phase grants no clinical permissions or editable clinical data.
        && profile.therapistNotes == [] && profile.prescribedDomains == []
        && profile.therapistGuidanceNote == '';
    }
    match /users/{uid}/progress/main {
      allow get: if owns(uid) || linkedProfessional(uid);
      allow create, update: if owns(uid) && validProgress();
    }
    match /users/{uid}/operations/{operationId} {
      allow get: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['kind', 'createdAt'])
        && request.resource.data.kind in ['result', 'settings', 'placement']
        && request.resource.data.createdAt == request.time;
    }
    function validExerciseResult(value) {
      return value.keys().hasOnly(['id', 'exerciseId', 'domain', 'date',
          'durationSeconds', 'accuracy', 'score', 'correctAnswers', 'totalQuestions',
          'difficulty', 'feedbackMessage', 'notes', 'mistakesList', 'level', 'configVersion', 'hintsUsed', 'practice', 'assignmentId', 'assignmentStep', 'assignmentOwnerId', 'assignmentSeatId'])
        && validAssignmentMetadata(value)
        && (!('level' in value) || (value.level is int && value.level >= 1 && value.level <= 10))
        && (!('configVersion' in value) || value.configVersion == 1)
        && (!('hintsUsed' in value) || (value.hintsUsed is int && value.hintsUsed >= 0))
        && (!('practice' in value) || value.practice == false)
        && value.id is string
        && value.exerciseId is string
        && value.domain in ['attention', 'language', 'memory', 'executive', 'motor']
        && value.date is string
        && value.durationSeconds is number && value.durationSeconds >= 0
        && value.accuracy is number && value.accuracy >= 0 && value.accuracy <= 100
        && value.correctAnswers is int && value.correctAnswers >= 0
        && value.totalQuestions is int && value.totalQuestions >= value.correctAnswers;
    }
    match /users/{uid}/results/{resultId} {
      allow read: if owns(uid) || linkedProfessional(uid);
      allow create: if owns(uid) && validExerciseResult(request.resource.data);
    }
    function validAssignmentMetadata(value) {
      return !value.keys().hasAny(['assignmentId', 'assignmentStep', 'assignmentOwnerId', 'assignmentSeatId'])
        || (value.assignmentId is string && value.assignmentId.matches('[A-Za-z0-9_-]{1,128}')
          && value.assignmentOwnerId is string && value.assignmentOwnerId.matches('[A-Za-z0-9_-]{1,128}')
          && value.assignmentSeatId is string && value.assignmentSeatId.matches('[A-Za-z0-9_-]{1,128}')
          && value.assignmentStep is int && value.assignmentStep >= 0 && value.assignmentStep < 8);
    }
    function sessionRelationship(owner, seatId, uid) {
      let professional = get(/databases/$(database)/documents/professionals/$(owner)).data;
      let seat = get(/databases/$(database)/documents/professionals/$(owner)/seats/$(seatId)).data;
      let access = get(/databases/$(database)/documents/users/$(uid)/access/main).data;
      let link = get(/databases/$(database)/documents/professionals/$(owner)/patients/$(uid)).data;
      return authenticated() && (request.auth.uid == owner || request.auth.uid == uid)
        && professional.active == true && professional.ownerUid == owner
        && seat.status == 'active' && seat.expiresAt > request.time.toMillis() && seat.occupantUid == uid
        && access.kind == 'invitation' && access.professionalId == owner && access.seatId == seatId
        && access.expiresAt > request.time.toMillis() && access.invitationCode == seat.invitationCode
        && link.patientId == uid && link.seatId == seatId;
    }
    function validSessionStep(step) {
      return step is map && step.keys().hasOnly(['exerciseId', 'level'])
        && step.exerciseId in ['visual-scanning', 'language-naming', 'word-completion', 'memory-path', 'memory-pairs', 'categorization', 'motor-target', 'motor-tracking']
        && step.level is int && step.level >= 1 && step.level <= 10;
    }
    function validSession(value, owner, seatId, uid) {
      let steps = value.steps;
      return value.keys().hasOnly(['professionalId', 'seatId', 'patientId', 'professionalName', 'title', 'note', 'steps', 'configVersion', 'status', 'completedCount', 'resultIds', 'createdAt', 'updatedAt'])
        && value.professionalId == owner && value.seatId == seatId && value.patientId == uid
        && value.professionalName == get(/databases/$(database)/documents/professionals/$(owner)).data.name
        && value.title is string && value.title.size() > 0 && value.title.size() <= 80
        && value.note is string && value.note.size() <= 280 && value.configVersion == 1
        && value.status == 'assigned' && value.completedCount == 0 && value.resultIds == []
        && value.createdAt == request.time && value.updatedAt == request.time
        && steps is list && steps.size() >= 1 && steps.size() <= 8
        && validSessionStep(steps[0])
        && (steps.size() < 2 || validSessionStep(steps[1]))
        && (steps.size() < 3 || validSessionStep(steps[2]))
        && (steps.size() < 4 || validSessionStep(steps[3]))
        && (steps.size() < 5 || validSessionStep(steps[4]))
        && (steps.size() < 6 || validSessionStep(steps[5]))
        && (steps.size() < 7 || validSessionStep(steps[6]))
        && (steps.size() < 8 || validSessionStep(steps[7]));
    }
    function validSessionAdvance(owner, seatId, uid, sessionId) {
      let before = resource.data;
      let after = request.resource.data;
      let index = before.completedCount;
      let resultId = after.resultIds[index];
      let result = get(/databases/$(database)/documents/users/$(uid)/results/$(resultId)).data;
      return before.status == 'in-progress' && index < before.steps.size()
        && after.diff(before).affectedKeys().hasOnly(['status', 'completedCount', 'resultIds', 'updatedAt'])
        && after.completedCount == index + 1
        && after.resultIds == before.resultIds.concat([resultId])
        && result.assignmentId == sessionId && result.assignmentStep == index
        && result.assignmentOwnerId == owner && result.assignmentSeatId == seatId
        && result.exerciseId == before.steps[index].exerciseId && result.level == before.steps[index].level
        && result.configVersion == before.configVersion && result.get('practice', false) == false
        && after.status == (after.completedCount == before.steps.size() ? 'completed' : 'in-progress');
    }
    match /professionals/{owner}/seats/{seatId}/participants/{uid}/sessions/{sessionId} {
      allow read: if sessionRelationship(owner, seatId, uid);
      allow create: if request.auth != null && request.auth.uid == owner && sessionId.matches('[A-Za-z0-9_-]{1,128}')
        && sessionRelationship(owner, seatId, uid) && validSession(request.resource.data, owner, seatId, uid);
      allow update: if sessionRelationship(owner, seatId, uid) && request.resource.data.updatedAt == request.time && (
        (request.auth.uid == owner && resource.data.status in ['assigned', 'in-progress'] && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || (request.auth.uid == uid && resource.data.status == 'assigned' && request.resource.data.status == 'in-progress'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || (request.auth.uid == uid && validSessionAdvance(owner, seatId, uid, sessionId)));
    }
    function noBilling(uid) {
      let path = /databases/$(database)/documents/billing/$(uid);
      return !exists(path) || (get(path).data.get('subscriptionId', null) == null
        && get(path).data.get('checkoutId', null) == null
        && get(path).data.get('attempt', null) == null);
    }
    function reservedProfessional() {
      let professional = getAfter(/databases/$(database)/documents/professionals/ceoaberto).data;
      return professional.name == 'CeoAberto' && professional.active == true;
    }
    function invitation(value) {
      return value.kind == 'invitation' && value.invitationCode == 'CEOABERTO'
        && value.professionalId == 'ceoaberto' && value.professionalName == 'CeoAberto'
        && value.expiresAt == null;
    }
    function matchingPatient(uid, linkedAt) {
      let patient = getAfter(/databases/$(database)/documents/professionals/ceoaberto/patients/$(uid)).data;
      return patient.patientId == uid && patient.linkedAt == linkedAt;
    }
    match /users/{uid}/access/main {
      allow get: if owns(uid);
      allow create: if owns(uid) && noBilling(uid) && (
        (request.resource.data.keys().hasOnly(['kind', 'trialStartedAt'])
          && request.resource.data.kind == 'trial'
          && request.resource.data.trialStartedAt == request.time)
        || (request.resource.data.keys().hasOnly(['kind', 'invitationCode', 'professionalId',
            'professionalName', 'expiresAt', 'linkedAt'])
          && invitation(request.resource.data) && reservedProfessional()
          && request.resource.data.linkedAt == request.time
          && matchingPatient(uid, request.resource.data.linkedAt)));
      allow update: if owns(uid) && noBilling(uid)
        && resource.data.kind in ['trial', 'invitation', 'revoked']
        && resource.data.get('professionalId', 'ceoaberto') == 'ceoaberto'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'kind', 'invitationCode', 'professionalId', 'professionalName', 'expiresAt', 'linkedAt'])
        && invitation(request.resource.data) && reservedProfessional()
        && request.resource.data.linkedAt == resource.data.get('linkedAt', request.time)
        && matchingPatient(uid, request.resource.data.linkedAt);
      allow update: if owns(uid) && noBilling(uid) && resource.data.kind == 'invitation'
        && resource.data.professionalId == 'ceoaberto' && !('seatId' in resource.data)
        && request.resource.data.keys().hasOnly(['kind', 'leftAt'])
        && request.resource.data.kind == 'revoked' && request.resource.data.leftAt == request.time
        && !existsAfter(/databases/$(database)/documents/professionals/ceoaberto/patients/$(uid));
    }
    match /professionals/ceoaberto {
      allow get: if authenticated();
      // Only this fixed unclaimed profile may be bootstrapped alongside a redemption.
      // Nobody can appoint themselves its owner or edit a professional from the app.
      allow create: if authenticated()
        && request.resource.data.keys().hasOnly(['name', 'active', 'ownerUid'])
        && request.resource.data.name == 'CeoAberto'
        && request.resource.data.active == true && request.resource.data.ownerUid == null
        && invitation(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/access/main).data)
        && matchingPatient(request.auth.uid,
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/access/main).data.linkedAt);
      match /patients/{uid} {
        allow get: if owns(uid);
        allow delete: if owns(uid) && noBilling(uid)
          && get(/databases/$(database)/documents/users/$(uid)/access/main).data.kind == 'invitation'
          && getAfter(/databases/$(database)/documents/users/$(uid)/access/main).data.kind == 'revoked'
          && getAfter(/databases/$(database)/documents/users/$(uid)/access/main).data.leftAt == request.time;
        allow create: if owns(uid) && noBilling(uid) && reservedProfessional()
          && request.resource.data.keys().hasOnly(['patientId', 'linkedAt'])
          && request.resource.data.patientId == uid
          && invitation(getAfter(/databases/$(database)/documents/users/$(uid)/access/main).data)
          && request.resource.data.linkedAt == getAfter(/databases/$(database)/documents/users/$(uid)/access/main).data.linkedAt;
      }
    }
    // A self-owned workspace is free; it is not a verified clinical credential.
    match /professionals/{professionalId} {
      allow get: if owns(professionalId);
      allow create: if owns(professionalId) && professionalId != 'ceoaberto'
        && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'active', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.createdAt == request.time;
      match /seats/{seatId} {
        allow read: if professionalOwner(professionalId);
      }
      match /patients/{uid} {
        allow read: if professionalOwner(professionalId);
      }
    }
    // Seats, codes, billing, reciprocal links and cross-account writes are server-only.
    // Legacy CEOABERTO ownership remains administrator-only; it grants no clinical access.
  }
}
